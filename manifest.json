{
  "manifest_version": 3,
  "name": "JanitorAI Stats Tracker",
  "version": "1.2.0",
  "description": "Track JanitorAI character messages, chats, comments and favourites over time.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "https://janitorai.com/*",
    "https://www.janitorai.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://janitorai.com/*",
        "https://www.janitorai.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "JanitorAI Stats Tracker",
    "default_popup": "popup.html"
  },
  "options_page": "dashboard.html"
}
