{
  "manifest_version": 3,
  "name": "JStats",
  "version": "1.3.0",
  "description": "Private local statistics and character analytics tracker for JanitorAI.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "https://janitorai.com/*",
    "https://www.janitorai.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://janitorai.com/*",
        "https://www.janitorai.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "JStats",
    "default_popup": "popup.html",
    "default_icon": "logo.webp"
  },
  "icons": {
    "128": "logo.webp"
  },
  "options_page": "dashboard.html"
}
